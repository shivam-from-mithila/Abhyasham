<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mainBgColor">

    <!-- ========================================================= -->
    <!-- MAIN CONTENT -->
    <!-- ========================================================= -->

    <ScrollView
        android:id="@+id/quickTestScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:background="@color/mainBgColor">

        <LinearLayout
            android:id="@+id/quickTestContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="125dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivPrepCenter"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="1dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/timer"
                    android:scaleType="centerInside"
                    />

                <TextView
                    android:id="@+id/tvPrepCenterTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PrepCenter"
                    android:textColor="@color/subjectNameTextColor"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/msans" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvPrepCenterSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="27dp"
                android:gravity="center"
                android:text="Practice smarter. Prepare better."
                android:textColor="@color/questionCountTxtColor"
                android:textSize="13sp"
                android:fontFamily="@font/msans" />


            <!-- ================================================= -->
            <!-- FEATURED TESTS -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvDailyChallengeHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="Featured Tests"
                android:textColor="@color/subjectNameTextColor"
                android:textSize="19sp"
                android:textStyle="bold"
                android:fontFamily="@font/msans" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="11dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="Stay consistent with daily and weekly practice"
                android:textColor="@color/questionCountTxtColor"
                android:textSize="12sp"
                android:fontFamily="@font/msans" />


            <!-- ================================================= -->
            <!-- DAILY CHALLENGE -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTodaysChallenge"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/cardBgColor"
                app:cardCornerRadius="17dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="15dp">

                    <ImageView
                        android:id="@+id/ivDailyChallenge"
                        android:layout_width="36dp"
                        android:layout_height="36dp"

                        android:src="@drawable/energy"
                        android:contentDescription="Daily Challenge"
                        android:scaleType="centerInside"
                        />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="13dp"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:id="@+id/tvTodaysChallenge"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Today's Challenge"
                            android:textColor="@color/subjectNameTextColor"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/msans" />

                        <TextView
                            android:id="@+id/tvDailyChallengeInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="20 Questions"
                            android:textColor="@color/questionCountTxtColor"
                            android:textSize="12sp"
                            android:fontFamily="@font/msans" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- WEEKLY TEST -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWeeklyTest"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="10dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/cardBgColor"
                app:cardCornerRadius="17dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="15dp">

                    <ImageView
                        android:id="@+id/ivWeeklyTest"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/bars"
                        android:contentDescription="Weekly Test"
                        android:scaleType="centerInside"
                        />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="13dp"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:id="@+id/tvWeeklyTest"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="This Week's Test"
                            android:textColor="@color/subjectNameTextColor"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/msans" />

                        <TextView
                            android:id="@+id/tvWeeklyTestInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="50 Questions"
                            android:textColor="@color/questionCountTxtColor"
                            android:textSize="12sp"
                            android:fontFamily="@font/msans" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- YEARWISE GS QUESTIONS -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvYearWiseHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="29dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="Yearwise GS Questions"
                android:textColor="@color/subjectNameTextColor"
                android:textSize="19sp"
                android:textStyle="bold"
                android:fontFamily="@font/msans" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="Practice UPSC CSE Prelims papers year wise"
                android:textColor="@color/questionCountTxtColor"
                android:textSize="12sp"
                android:fontFamily="@font/msans" />


            <!-- ================================================= -->
            <!-- YEAR GRID -->
            <!-- ================================================= -->

            <GridLayout
                android:id="@+id/yearWiseGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="false">


                <!-- 2026 -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardYear2026"
                    android:layout_width="0dp"
                    android:layout_height="118dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/cardBgColor"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="2dp">

                    <TextView
                        android:id="@+id/tvYear2026Name"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="2026"
                        android:textColor="@color/subjectNameTextColor"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/msans" />

                </com.google.android.material.card.MaterialCardView>


                <!-- 2025 -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardYear2025"
                    android:layout_width="0dp"
                    android:layout_height="118dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/cardBgColor"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="2dp">

                    <TextView
                        android:id="@+id/tvYear2025Name"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="2025"
                        android:textColor="@color/subjectNameTextColor"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/msans" />

                </com.google.android.material.card.MaterialCardView>


                <!-- 2024 -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardYear2024"
                    android:layout_width="0dp"
                    android:layout_height="118dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/cardBgColor"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="2dp">

                    <TextView
                        android:id="@+id/tvYear2024Name"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="2024"
                        android:textColor="@color/subjectNameTextColor"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/msans" />

                </com.google.android.material.card.MaterialCardView>


                <!-- 2023 -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardYear2023"
                    android:layout_width="0dp"
                    android:layout_height="118dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/cardBgColor"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="2dp">

                    <TextView
                        android:id="@+id/tvYear2023Name"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="2023"
                        android:textColor="@color/subjectNameTextColor"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/msans" />

                </com.google.android.material.card.MaterialCardView>


                <!-- 2022 -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardYear2022"
                    android:layout_width="0dp"
                    android:layout_height="118dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/cardBgColor"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="2dp">

                    <TextView
                        android:id="@+id/tvYear2022Name"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="2022"
                        android:textColor="@color/subjectNameTextColor"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/msans" />

                </com.google.android.material.card.MaterialCardView>


                <!-- 2021 -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardYear2021"
                    android:layout_width="0dp"
                    android:layout_height="118dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/cardBgColor"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="2dp">

                    <TextView
                        android:id="@+id/tvYear2021Name"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="2021"
                        android:textColor="@color/subjectNameTextColor"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/msans" />

                </com.google.android.material.card.MaterialCardView>


                <!-- 2020 -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardYear2020"
                    android:layout_width="0dp"
                    android:layout_height="118dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/cardBgColor"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="2dp">

                    <TextView
                        android:id="@+id/tvYear2020Name"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="2020"
                        android:textColor="@color/subjectNameTextColor"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/msans" />

                </com.google.android.material.card.MaterialCardView>


                <!-- 2019 -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardYear2019"
                    android:layout_width="0dp"
                    android:layout_height="118dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/cardBgColor"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="2dp">

                    <TextView
                        android:id="@+id/tvYear2019Name"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="2019"
                        android:textColor="@color/subjectNameTextColor"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/msans" />

                </com.google.android.material.card.MaterialCardView>

            </GridLayout>


            <!-- ================================================= -->
            <!-- SUBJECT PRACTICE -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvSubjectWiseHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="Subject Practice"
                android:textColor="@color/subjectNameTextColor"
                android:textSize="19sp"
                android:textStyle="bold"
                android:fontFamily="@font/msans" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="Focus on one subject at a time"
                android:textColor="@color/questionCountTxtColor"
                android:textSize="12sp"
                android:fontFamily="@font/msans" />


            <!-- ================================================= -->
            <!-- SUBJECT GRID -->
            <!-- ================================================= -->

            <GridLayout
                android:id="@+id/subjectWiseGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="false">


                <!-- ==================== POLITY ==================== -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSubjectPolity"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/cardBgColor"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/ivSubjectPolity"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:src="@drawable/state"
                            app:tint="@color/subjectIconColor"
                            android:contentDescription="Polity"
                            android:scaleType="centerInside" />

                        <TextView
                            android:id="@+id/tvSubjectPolity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:gravity="center"
                            android:text="Polity"
                            android:textColor="@color/subjectNameTextColor"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/msans" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ==================== HISTORY ==================== -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSubjectHistory"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/cardBgColor"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/ivSubjectHistory"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:src="@drawable/parchment"
                            app:tint="@color/subjectIconColor"
                            android:contentDescription="History"
                            android:scaleType="centerInside" />

                        <TextView
                            android:id="@+id/tvSubjectHistory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:gravity="center"
                            android:text="History"
                            android:textColor="@color/subjectNameTextColor"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/msans" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ==================== GEOGRAPHY ==================== -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSubjectGeography"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/cardBgColor"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/ivSubjectGeography"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:src="@drawable/globe"
                            app:tint="@color/subjectIconColor"
                            android:contentDescription="Geography"
                            android:scaleType="centerInside" />

                        <TextView
                            android:id="@+id/tvSubjectGeography"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:gravity="center"
                            android:text="Geography"
                            android:textColor="@color/subjectNameTextColor"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/msans" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ==================== ECONOMY ==================== -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSubjectEconomy"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/cardBgColor"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/ivSubjectEconomy"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:src="@drawable/ic_economy"
                            app:tint="@color/subjectIconColor"
                            android:contentDescription="Economy"
                            android:scaleType="centerInside" />

                        <TextView
                            android:id="@+id/tvSubjectEconomy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:gravity="center"
                            android:text="Economy"
                            android:textColor="@color/subjectNameTextColor"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/msans" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ==================== ENVIRONMENT ==================== -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSubjectEnvironment"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/cardBgColor"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/ivSubjectEnvironment"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:src="@drawable/environment"
                            app:tint="@color/subjectIconColor"
                            android:contentDescription="Environment"
                            android:scaleType="centerInside" />

                        <TextView
                            android:id="@+id/tvSubjectEnvironment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:gravity="center"
                            android:text="Environment"
                            android:textColor="@color/subjectNameTextColor"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/msans" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>
                <!-- ==================== SCIENCE & TECHNOLOGY ==================== -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSubjectScienceTech"
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/cardBgColor"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/ivSubjectScienceTech"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:src="@drawable/dna"
                            app:tint="@color/subjectIconColor"
                            android:contentDescription="Science and Technology"
                            android:scaleType="centerInside" />

                        <TextView
                            android:id="@+id/tvSubjectScienceTech"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:gravity="center"
                            android:text="Science &amp; Tech"
                            android:textColor="@color/subjectNameTextColor"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/msans" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>
            </GridLayout>

        </LinearLayout>

    </ScrollView>


    <!-- ========================================================= -->
