                        android:scaleType="centerInside" />


                    <TextView
                        android:id="@+id/tvYear2023Name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="13dp"
                        android:layout_marginEnd="8dp"
                        android:text="UPSC CSE PRE 2023"
                        android:textColor="@color/subjectNameTextColor"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/msans" />


                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnYear2023Practice"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:text="PRACTICE"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/msans"
                        app:backgroundTint="@color/btnBgColor"
                        app:cornerRadius="10dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- YEAR 2022 -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardYear2022"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                app:cardBackgroundColor="@color/cardBgColor"
                app:cardCornerRadius="17dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/topicCardStroke">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">


                    <ImageView
                        android:id="@+id/ivYear2022"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/exam"
                        android:contentDescription="Question paper"
                        android:scaleType="centerInside" />


                    <TextView
                        android:id="@+id/tvYear2022Name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
