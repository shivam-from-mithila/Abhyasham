                        android:layout_marginStart="13dp"
                        android:layout_marginEnd="8dp"
                        android:text="UPSC CSE PRE 2022"
                        android:textColor="@color/subjectNameTextColor"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/msans" />


                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnYear2022Practice"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:text="PRACTICE"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/msans"
                        app:backgroundTint="@color/btnBgColor"
                        app:cornerRadius="10dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- SUBJECT WISE TEST -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvSubjectWiseHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Subject Wise Test"
                android:textColor="@color/subjectNameTextColor"
                android:textSize="19sp"
                android:textStyle="bold"
                android:fontFamily="@font/msans" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="10dp"
                android:text="Practice questions subject wise"
                android:textColor="@color/questionCountTxtColor"
                android:textSize="12sp"
                android:fontFamily="@font/msans" />


            <!-- POLITY -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSubjectPolity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/cardBgColor"
                app:cardCornerRadius="17dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/topicCardStroke">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">


                    <ImageView
                        android:id="@+id/ivSubjectPolity"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/state"
                        android:contentDescription="Polity"
                        android:scaleType="centerInside" />


                    <TextView
                        android:id="@+id/tvSubjectPolity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="13dp"
                        android:layout_marginEnd="8dp"
                        android:text="Polity"
                        android:textColor="@color/subjectNameTextColor"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/msans" />


                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPolityPractice"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:text="PRACTICE"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/msans"
                        app:backgroundTint="@color/btnBgColor"
                        app:cornerRadius="10dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- HISTORY -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSubjectHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                app:cardBackgroundColor="@color/cardBgColor"
                app:cardCornerRadius="17dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/topicCardStroke">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">


                    <ImageView
                        android:id="@+id/ivSubjectHistory"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/parchment"
                        android:contentDescription="History"
                        android:scaleType="centerInside" />


                    <TextView
                        android:id="@+id/tvSubjectHistory"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="13dp"
                        android:layout_marginEnd="8dp"
                        android:text="History"
                        android:textColor="@color/subjectNameTextColor"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/msans" />


                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHistoryPractice"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:text="PRACTICE"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/msans"
                        app:backgroundTint="@color/btnBgColor"
                        app:cornerRadius="10dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- GEOGRAPHY -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSubjectGeography"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                app:cardBackgroundColor="@color/cardBgColor"
                app:cardCornerRadius="17dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/topicCardStroke">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">


                    <ImageView
                        android:id="@+id/ivSubjectGeography"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/globe"
                        android:contentDescription="Geography"
                        android:scaleType="centerInside" />


                    <TextView
                        android:id="@+id/tvSubjectGeography"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="13dp"
                        android:layout_marginEnd="8dp"
                        android:text="Geography"
                        android:textColor="@color/subjectNameTextColor"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/msans" />


                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGeographyPractice"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:text="PRACTICE"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/msans"
                        app:backgroundTint="@color/btnBgColor"
                        app:cornerRadius="10dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ECONOMY -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSubjectEconomy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                app:cardBackgroundColor="@color/cardBgColor"
                app:cardCornerRadius="17dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/topicCardStroke">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">


                    <ImageView
                        android:id="@+id/ivSubjectEconomy"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_economy"
                        android:contentDescription="Economy"
                        android:scaleType="centerInside" />


                    <TextView
                        android:id="@+id/tvSubjectEconomy"
                        android:layout_width="0dp"
