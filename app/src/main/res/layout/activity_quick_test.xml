<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mainBgColor">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:background="@color/mainBgColor">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="90dp">


            <!-- HEADER -->

            <TextView
                android:id="@+id/tvPrepCenterTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Prep Center"
                android:textColor="@color/subjectNameTextColor"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="@font/msans" />


            <TextView
                android:id="@+id/tvPrepCenterSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="25dp"
                android:gravity="center"
                android:text="Practice smarter. Prepare better."
                android:textColor="@color/questionCountTxtColor"
                android:textSize="13sp"
                android:fontFamily="@font/msans" />


            <!-- ================================================= -->
            <!-- DAILY CHALLENGE -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvDailyChallengeHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Daily Challenge"
                android:textColor="@color/subjectNameTextColor"
                android:textSize="19sp"
                android:textStyle="bold"
                android:fontFamily="@font/msans" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="10dp"
                android:text="A new challenge every day"
                android:textColor="@color/questionCountTxtColor"
                android:textSize="12sp"
                android:fontFamily="@font/msans" />


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTodaysChallenge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/cardBgColor"
                app:cardCornerRadius="17dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/topicCardStroke">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="15dp">


                    <TextView
                        android:id="@+id/ivDailyChallenge"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:text="🔥"
                        android:textSize="23sp"
                        android:fontFamily="@font/msans" />


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp">


                        <TextView
                            android:id="@+id/tvTodaysChallenge"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Today's Challenge"
                            android:textColor="@color/subjectNameTextColor"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/msans" />


                        <TextView
                            android:id="@+id/tvDailyChallengeInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Mixed Questions • 20 Questions"
                            android:textColor="@color/questionCountTxtColor"
                            android:textSize="12sp"
                            android:fontFamily="@font/msans" />

                    </LinearLayout>


                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDailyChallengePractice"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:text="PRACTICE"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/msans"
                        app:backgroundTint="@color/btnBgColor"
                        app:cornerRadius="10dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- YEAR WISE PRACTICE -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvYearWiseHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Year Wise Practice"
                android:textColor="@color/subjectNameTextColor"
                android:textSize="19sp"
                android:textStyle="bold"
                android:fontFamily="@font/msans" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="10dp"
                android:text="Practice previous years' questions"
                android:textColor="@color/questionCountTxtColor"
                android:textSize="12sp"
                android:fontFamily="@font/msans" />


            <!-- YEAR 2024 -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardYear2024"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/cardBgColor"
                app:cardCornerRadius="17dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/topicCardStroke">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">


                    <ImageView
                        android:id="@+id/ivYear2024"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/exam"
                        android:contentDescription="Question paper"
                        android:scaleType="centerInside" />


                    <TextView
                        android:id="@+id/tvYear2024Name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="13dp"
                        android:layout_marginEnd="8dp"
                        android:text="UPSC CSE PRE 2024"
                        android:textColor="@color/subjectNameTextColor"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/msans" />


                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnYear2024Practice"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:text="PRACTICE"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/msans"
                        app:backgroundTint="@color/btnBgColor"
                        app:cornerRadius="10dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- YEAR 2023 -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardYear2023"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                app:cardBackgroundColor="@color/cardBgColor"
                app:cardCornerRadius="17dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/topicCardStroke">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
