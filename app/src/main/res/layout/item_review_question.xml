<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginBottom="16dp"

    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="@color/cardBgColor"
    app:strokeWidth="1dp"
    app:strokeColor="@color/topicCardStroke">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        android:padding="18dp">


        <!-- Question Number -->

        <TextView
            android:id="@+id/tvReviewQuestionNumber"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Question 1"
            android:textSize="14sp"
            android:textStyle="bold"

            android:textColor="@color/questionCountTxtColor"

            android:layout_marginBottom="8dp" />


        <!-- Question -->

        <TextView
            android:id="@+id/tvReviewQuestion"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Question text"

            android:textSize="17sp"
            android:textStyle="bold"

            android:textColor="@color/subjectNameTextColor"

            android:lineSpacingExtra="2dp"

            android:layout_marginBottom="16dp" />


        <!-- Options -->

        <TextView
            android:id="@+id/tvReviewOptionA"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="A. Option A"
            android:textSize="15sp"

            android:textColor="@color/subjectNameTextColor"

            android:paddingVertical="4dp"
            android:layout_marginBottom="4dp" />


        <TextView
            android:id="@+id/tvReviewOptionB"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="B. Option B"
            android:textSize="15sp"

            android:textColor="@color/subjectNameTextColor"

            android:paddingVertical="4dp"
            android:layout_marginBottom="4dp" />


        <TextView
            android:id="@+id/tvReviewOptionC"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="C. Option C"
            android:textSize="15sp"

            android:textColor="@color/subjectNameTextColor"

            android:paddingVertical="4dp"
            android:layout_marginBottom="4dp" />


        <TextView
            android:id="@+id/tvReviewOptionD"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="D. Option D"
            android:textSize="15sp"

            android:textColor="@color/subjectNameTextColor"

            android:paddingVertical="4dp"

            android:layout_marginBottom="16dp" />


        <!-- Result Status -->

        <LinearLayout
            android:id="@+id/resultStatusContainer"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:padding="12dp"

            android:background="@drawable/bg_review_status">


            <TextView
                android:id="@+id/tvResultStatus"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Correct"

                android:textSize="16sp"
                android:textStyle="bold"

                android:textColor="@color/reviewCorrectText" />


            <TextView
                android:id="@+id/tvYourAnswer"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Your Answer: A"

                android:textSize="14sp"

                android:textColor="@color/subjectNameTextColor"

                android:layout_marginTop="6dp" />


            <TextView
                android:id="@+id/tvCorrectAnswer"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Correct Answer: A"

                android:textSize="14sp"
                android:textStyle="bold"

                android:textColor="@color/subjectNameTextColor"

                android:layout_marginTop="4dp" />

        </LinearLayout>


        <!-- Explanation -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:padding="12dp"

            android:background="@drawable/bg_review_explanation"

            android:layout_marginTop="12dp">


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Explanation"

                android:textSize="14sp"
                android:textStyle="bold"

                android:textColor="@color/subjectNameTextColor"

                android:layout_marginBottom="6dp" />


            <TextView
                android:id="@+id/tvExplanation"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Explanation"

                android:textSize="14sp"

                android:textColor="@color/questionCountTxtColor"

                android:lineSpacingExtra="2dp" />

        </LinearLayout>


    </LinearLayout>

</com.google.android.material.card.MaterialCardView>