<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/mainBgColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">


        <!-- ========================= -->
        <!-- Header -->
        <!-- ========================= -->

        <TextView
            android:id="@+id/tvResultTitle"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/msans"

            android:text="Quiz Completed"
            android:textSize="28sp"
            android:textStyle="bold"

            android:textColor="@color/subjectNameTextColor"

            android:gravity="center"

            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Here is your performance summary"
            android:textSize="14sp"
            android:fontFamily="@font/msans"
            android:textColor="@color/questionCountTxtColor"

            android:gravity="center"

            android:layout_marginBottom="22dp" />


        <!-- ========================= -->
        <!-- Score Card -->
        <!-- ========================= -->

        <com.google.android.material.card.MaterialCardView

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/cardBgColor"

            app:strokeWidth="1dp"
            app:strokeColor="@color/topicCardStroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"
                android:gravity="center"

                android:padding="26dp">


                <!-- Trophy -->

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"

                    android:src="@drawable/ic_trophy"

                    android:contentDescription="Trophy"

                    android:layout_marginBottom="8dp" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Your Score"
                    android:fontFamily="@font/msans"
                    android:textSize="15sp"

                    android:textColor="@color/questionCountTxtColor"

                    android:layout_marginBottom="2dp" />


                <TextView
                    android:id="@+id/tvScore"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="0%"

                    android:textSize="46sp"
                    android:textStyle="bold"

                    android:textColor="@color/btnBgColor" />


                <TextView
                    android:id="@+id/tvScoreLabel"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Score"
                    android:textSize="14sp"
                    android:fontFamily="@font/msans"

                    android:textColor="@color/questionCountTxtColor"

                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ========================= -->
        <!-- Statistics -->
        <!-- ========================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"
            android:weightSum="3"

            android:layout_marginTop="16dp">


            <!-- ========================= -->
            <!-- Correct -->
            <!-- ========================= -->

            <com.google.android.material.card.MaterialCardView

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"
                android:layout_marginEnd="5dp"

                app:cardCornerRadius="15dp"
                app:cardBackgroundColor="@color/cardBgColor"

                app:strokeWidth="1dp"
                app:strokeColor="@color/topicCardStroke">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"
                    android:gravity="center"

                    android:padding="14dp">


                    <!-- Icon Container -->

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"

                        android:background="@drawable/bg_review_correct"

                        android:layout_marginBottom="7dp">

                        <ImageView
                            android:layout_width="21dp"
                            android:layout_height="21dp"

                            android:layout_gravity="center"

                            android:src="@drawable/ic_correct"

                            android:contentDescription="Correct" />

                    </FrameLayout>


                    <TextView
                        android:id="@+id/tvCorrectCount"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="0"

                        android:textSize="25sp"
                        android:fontFamily="@font/msans"
                        android:textStyle="bold"

                        android:textColor="@color/reviewCorrectText" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Correct"
                        android:textSize="12sp"
                        android:fontFamily="@font/msans"

                        android:textColor="@color/questionCountTxtColor"

                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ========================= -->
            <!-- Incorrect -->
            <!-- ========================= -->

            <com.google.android.material.card.MaterialCardView

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:layout_marginHorizontal="5dp"

                app:cardCornerRadius="15dp"
                app:cardBackgroundColor="@color/cardBgColor"

                app:strokeWidth="1dp"
                app:strokeColor="@color/topicCardStroke">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"
                    android:gravity="center"

                    android:padding="14dp">


                    <!-- Icon Container -->

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"

                        android:background="@drawable/bg_review_incorrect"

                        android:layout_marginBottom="7dp">

                        <ImageView
                            android:layout_width="21dp"
                            android:layout_height="21dp"

                            android:layout_gravity="center"

                            android:src="@drawable/ic_incorrect"

                            android:contentDescription="Incorrect" />

                    </FrameLayout>


                    <TextView
                        android:id="@+id/tvIncorrectCount"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="0"
                        android:fontFamily="@font/msans"
                        android:textSize="25sp"
                        android:textStyle="bold"

                        android:textColor="@color/reviewIncorrectText" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Incorrect"
                        android:textSize="12sp"
                        android:fontFamily="@font/msans"
                        android:textColor="@color/questionCountTxtColor"

                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ========================= -->
            <!-- Unattempted -->
            <!-- ========================= -->

            <com.google.android.material.card.MaterialCardView

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"
                android:layout_marginStart="5dp"

                app:cardCornerRadius="15dp"
                app:cardBackgroundColor="@color/cardBgColor"

                app:strokeWidth="1dp"
                app:strokeColor="@color/topicCardStroke">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"
                    android:gravity="center"

                    android:padding="14dp">


                    <!-- Icon Container -->

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"

                        android:background="@drawable/bg_review_unattempted"

                        android:layout_marginBottom="7dp">

                        <ImageView
                            android:layout_width="21dp"
                            android:layout_height="21dp"

                            android:layout_gravity="center"

                            android:src="@drawable/ic_unattempted"

                            android:contentDescription="Unattempted" />

                    </FrameLayout>


                    <TextView
                        android:id="@+id/tvUnansweredCount"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="0"
                        android:fontFamily="@font/msans"

                        android:textSize="25sp"
                        android:textStyle="bold"

                        android:textColor="@color/reviewUnattemptedText" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unattempted"
                        android:textSize="11sp"
                        android:fontFamily="@font/msans"
                        android:textColor="@color/questionCountTxtColor"
                        android:gravity="center"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>


        <!-- ========================= -->
        <!-- Total Questions -->
        <!-- ========================= -->

        <TextView
            android:id="@+id/tvTotalQuestions"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Total Questions: 0"
            android:fontFamily="@font/msans"
            android:textSize="15sp"
            android:textStyle="bold"

            android:textColor="@color/subjectNameTextColor"

            android:gravity="center"

            android:layout_marginTop="20dp" />


        <!-- ========================= -->
        <!-- Review Button -->
        <!-- ========================= -->

        <com.google.android.material.button.MaterialButton

            android:id="@+id/btnReviewAnswers"

            android:layout_width="match_parent"
            android:layout_height="52dp"

            android:text="REVIEW ANSWERS"
            android:fontFamily="@font/msans"

            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"

            android:layout_marginTop="18dp"
            android:textColor="@color/abhyashamBtnTextColor"

            app:cornerRadius="14dp"
            app:backgroundTint="@color/btnBgColor" />


        <!-- ========================= -->
        <!-- Finish Button -->
        <!-- ========================= -->

        <com.google.android.material.button.MaterialButton

            android:id="@+id/btnFinish"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="FINISH"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"

            android:layout_marginTop="10dp"
            android:fontFamily="@font/msans"

            style="@style/Widget.Material3.Button.OutlinedButton"

            app:cornerRadius="14dp"
            app:strokeColor="@color/topicCardStroke"

            android:textColor="@color/subjectNameTextColor" />

    </LinearLayout>

</ScrollView>