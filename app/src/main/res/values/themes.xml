<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.PractiX" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primaryBlue</item>
        <item name="colorPrimaryVariant">@color/primaryBlue</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- Customize your theme here. -->
    </style>


    <style name="Theme.PractiX.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/primaryBlue</item>

        <item name="windowSplashScreenIconBackgroundColor">@color/primaryBlue</item>
        <item name="postSplashScreenTheme">@style/Theme.Practix</item>
    </style>
    <style name="Theme.Practix" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#5E4AE3</item>
    </style>

    <style name="Theme.Abhyasham.Starting" parent="Theme.SplashScreen">

        <item name="windowSplashScreenBackground">#F8FAFC</item>

        <item name="windowSplashScreenAnimatedIcon">
           @mipmap/ic_launcher
        </item>
        <!-- Same status bar as SecondActivity -->
        <item name="android:statusBarColor">@color/status_bar</item>


        <item name="postSplashScreenTheme">
            @style/Theme.PractiX
        </item>


    </style>

</resources>